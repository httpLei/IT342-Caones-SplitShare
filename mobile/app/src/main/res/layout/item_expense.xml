<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/SplitShare.Card"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvExpenseIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_container"
            android:text="🛒"
            android:textSize="16sp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvExpenseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groceries — SM"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvExpenseSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paid by you · May 9"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <!-- Receipt dot -->
                <View
                    android:id="@+id/receiptDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_receipt_dot"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvReceiptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receipt"
                    android:textSize="11sp"
                    android:textColor="@color/green_owed"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/tvExpenseTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱700.00"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/tvExpenseShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your share: ₱175"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:gravity="end" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
